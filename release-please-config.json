{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "json",
          "path": "crates/opportune-wasm/js/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "crates/opportune-wasm/js/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "crates/opportune-wasm/js/package-lock.json",
          "jsonpath": "$.packages[\"\"].version"
        },
        {
          "type": "toml",
          "path": "crates/opportune-adapters/Cargo.toml",
          "jsonpath": "$['dependencies']['opportune']['version']"
        },
        {
          "type": "toml",
          "path": "crates/opportune-adapters/Cargo.toml",
          "jsonpath": "$['dependencies']['opportune-json']['version']"
        },
        {
          "type": "toml",
          "path": "crates/opportune-json/Cargo.toml",
          "jsonpath": "$['dependencies']['opportune']['version']"
        },
        {
          "type": "toml",
          "path": "crates/opportune-py/Cargo.toml",
          "jsonpath": "$['dependencies']['opportune']['version']"
        },
        {
          "type": "toml",
          "path": "crates/opportune-py/Cargo.toml",
          "jsonpath": "$['dependencies']['opportune-json']['version']"
        },
        {
          "type": "toml",
          "path": "crates/opportune-py/Cargo.toml",
          "jsonpath": "$['dependencies']['opportune-adapters']['version']"
        },
        {
          "type": "toml",
          "path": "crates/opportune-testkit/Cargo.toml",
          "jsonpath": "$['dependencies']['opportune']['version']"
        },
        {
          "type": "toml",
          "path": "crates/opportune-testkit/Cargo.toml",
          "jsonpath": "$['dependencies']['opportune-json']['version']"
        },
        {
          "type": "toml",
          "path": "crates/opportune-testkit/Cargo.toml",
          "jsonpath": "$['dependencies']['opportune-adapters']['version']"
        },
        {
          "type": "toml",
          "path": "crates/opportune-wasm/Cargo.toml",
          "jsonpath": "$['dependencies']['opportune']['version']"
        },
        {
          "type": "toml",
          "path": "crates/opportune-wasm/Cargo.toml",
          "jsonpath": "$['dependencies']['opportune-json']['version']"
        },
        {
          "type": "toml",
          "path": "crates/opportune-wasm/Cargo.toml",
          "jsonpath": "$['dependencies']['opportune-adapters']['version']"
        },
        {
          "type": "generic",
          "path": "crates/opportune-wasm/js/src/constants.ts"
        }
      ]
    }
  }
}
