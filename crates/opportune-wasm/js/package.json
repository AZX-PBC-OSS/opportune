{
  "name": "opportune",
  "version": "0.2.0",
  "description": "Availability scheduling: WASM binding of the opportune engine for JavaScript and TypeScript.",
  "author": "AZX, PBC. <oss@azx.io>",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AZX-PBC-OSS/opportune.git"
  },
  "homepage": "https://github.com/AZX-PBC-OSS/opportune/tree/main/crates/opportune-wasm/js#readme",
  "keywords": [
    "availability",
    "scheduling",
    "calendar",
    "booking",
    "time-zones",
    "wasm"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24"
  },
  "packageManager": "npm@11.20.0",
  "sideEffects": false,
  "imports": {
    "#wasm": {
      "types": "./dist/wasm-node.d.ts",
      "workerd": "./dist/wasm-workerd.js",
      "browser": "./dist/wasm-web.js",
      "worker": "./dist/wasm-web.js",
      "node": "./dist/wasm-node.js",
      "default": "./dist/wasm-node.js"
    },
    "#wasm-glue": "./dist/pkg/opportune_wasm.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./presets": {
      "types": "./dist/presets-entry.d.ts",
      "default": "./dist/presets-entry.js"
    },
    "./adapters/graph": {
      "types": "./dist/adapters/graph.d.ts",
      "default": "./dist/adapters/graph.js"
    },
    "./adapters/google": {
      "types": "./dist/adapters/google.d.ts",
      "default": "./dist/adapters/google.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./opportune_wasm_bg.wasm": "./dist/pkg/opportune_wasm_bg.wasm",
    "./package.json": "./package.json",
    "./schema.json": "./schema.json"
  },
  "files": [
    "dist",
    "schema.json",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "README.md"
  ],
  "scripts": {
    "build": "node bin/clean.mjs && tsc -p tsconfig.build.json && node bin/bundle-module.mjs",
    "check": "tsc -p tsconfig.check.json",
    "test": "node --test tests/"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.0.0",
    "json-schema-to-typescript": "^15.0.4",
    "publint": "^0.3.25",
    "shell-quote": "^1.12.0",
    "typescript": "^5.9.0",
    "yaml": "^2.9.1"
  }
}
